{
  "name": "AI Hackathon Solution Workflow",
  "description": "Generic n8n workflow template for AI-powered solutions that saves files to Google Drive and sends notifications",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-trigger",
        "responseMode": "responseNode"
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "prompt": "You are a helpful AI assistant. Task: {{$json.content}}\n\nContext: {{$json.context}}\n\nReturn result in JSON format with field 'output'",
        "temperature": 0.7,
        "maxTokens": 2000
      },
      "name": "OpenAI Node",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "functionCode": "const result = items[0].json;
const output = result.openai?.output || result.output || result;
const timestamp = new Date().toISOString();

return [{
  json: {
    ...output,
    timestamp,
    processed: true
  }
}];"
      },
      "name": "Process Result",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [750, 300]
    },
    {
      "parameters": {
        "operation": "upload",
        "parentId": {"=": "={{$credentials.driveFolderId}}"},
        "binaryData": false,
        "options": {}
      },
      "name": "Save to Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 2,
      "position": [1000, 400],
      "credentials": {
        "googleApi": "googleDriveOAuth"
      }
    },
    {
      "parameters": {
        "channel": "#general",
        "text": "🤖 New result from AI workflow:\n{{$json.output}}\n\nProcessed at: {{$json.timestamp}}"
      },
      "name": "Slack Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1000, 200],
      "credentials": {
        "slackApi": "slackOAuth"
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "options": {}
      },
      "name": "Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 3,
      "position": [1250, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [[{"node": "OpenAI Node", "type": "main", "index": 0}]]}
    },
    "OpenAI Node": {
      "main": [[{"node": "Process Result", "type": "main", "index": 0}]]}
    },
    "Process Result": {
      "main": [[
        {"node": "Save to Drive", "type": "main", "index": 0},
        {"node": "Slack Alert", "type": "main", "index": 0},
        {"node": "Response", "type": "main", "index": 0}
      ]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "hackathon-template"
  }
}